    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.target.classList.add('active');
        }

        const gameData = [
            { q: "Rumah adat yang atapnya melengkung menyerupai tanduk kerbau berasal dari...", options: ["Sumatra Barat", "Papua", "Jawa Tengah", "Bali"], answer: "Sumatra Barat" },
            { q: "Tarian kelompok dari Aceh yang terkenal dengan gerakan tepuk tangan cepat adalah...", options: ["Tari Kecak", "Tari Saman", "Tari Jaipong", "Tari Pendet"], answer: "Tari Saman" },
            { q: "Semboyan negara Indonesia yang berarti berbeda-beda tetapi tetap satu adalah...", options: ["Tut Wuri Handayani", "Bhinneka Tunggal Ika", "Pancasila", "Garuda Pancasila"], answer: "Bhinneka Tunggal Ika" },
            { q: "Lagu daerah 'Apuse' berasal dari provinsi...", options: ["Kalimantan Selatan", "Jawa Tengah", "Papua", "Aceh"], answer: "Papua" }
        ];

        let currentGameIdx = 0;
        let gameScore = 0;

        function initGame() {
            currentGameIdx = 0;
            gameScore = 0;
            document.getElementById('game-score').innerText = "Skor Kamu: 0";
            loadGameQuestion();
        }

        function loadGameQuestion() {
            if(currentGameIdx >= gameData.length) {
                document.getElementById('game-question').innerText = "🎉 Hore! Kamu telah menyelesaikan Mini-Game Tebak Budaya!";
                document.getElementById('game-options').innerHTML = "";
                return;
            }
            let current = gameData[currentGameIdx];
            document.getElementById('game-question').innerText = current.q;
            let optHTML = "";
            current.options.forEach(opt => {
                optHTML += `<button class="option-btn" onclick="checkGameAnswer('${opt}', '${current.answer}')">${opt}</button>`;
            });
            document.getElementById('game-options').innerHTML = optHTML;
        }

        function checkGameAnswer(selected, correct) {
            if(selected === correct) {
                gameScore += 25;
                alert("Hebat! Jawabanmu Benar! 👍");
            } else {
                alert("Belum tepat. Jawabannya adalah: " + correct);
            }
            document.getElementById('game-score').innerText = "Skor Kamu: " + gameScore;
            currentGameIdx++;
            loadGameQuestion();
        }

        const quizLevels = {
            1: [
                { q: "Rumah adat Honai berasal dari daerah...", options: ["Papua", "Sumatra", "Jawa", "Bali"], answer: "Papua" },
                { q: "Pakaian adat Ulee Balang berasal dari...", options: ["Aceh", "Sulawesi", "Riau", "Lampung"], answer: "Aceh" }
            ],
            2: [
                { q: "Permainan tradisional lompat tali karet dari Jawa Barat disebut...", options: ["Congklak", "Sapintrong", "Egrang", "Engklek"], answer: "Sapintrong" },
                { q: "Lagu daerah 'Ampar-Ampar Pisang' berasal dari...", options: ["Kalimantan Selatan", "Jawa Tengah", "Maluku", "Sumatra Utara"], answer: "Kalimantan Selatan" }
            ],
            3: [
                { q: "Rumah adat Tongkonan dengan ukiran khasnya berasal dari Suku Toraja di provinsi...", options: ["Sulawesi Selatan", "Sulawesi Utara", "Kalimantan Timur", "Nusa Tenggara Timur"], answer: "Sulawesi Selatan" },
                { q: "Pakaian tradisional wanita Minangkabau yang memiliki hiasan kepala menyerupai tanduk kerbau dinamakan...", options: ["Bundo Kanduang", "Ulos", "Kebaya Encim", "Baju Bodo"], answer: "Bundo Kanduang" }
            ]
        };

        let currentLevel = 1;
        let currentQuizIdx = 0;
        let quizScore = 0;

        function changeQuizLevel(level) {
            currentLevel = level;
            currentQuizIdx = 0;
            quizScore = 0;
            
            document.querySelectorAll('.level-btn').forEach((btn, idx) => {
                if(idx + 1 === level) btn.classList.add('active-level');
                else btn.classList.remove('active-level');
            });
            
            document.getElementById('quiz-level-info').innerText = `Level ${level}: ${level === 1 ? 'Mengenal Dasar Budaya' : level === 2 ? 'Tingkat Menengah' : 'Tantangan Master Budaya'}`;
            loadQuizQuestion();
        }

        function loadQuizQuestion() {
            let questions = quizLevels[currentLevel];
            if(currentQuizIdx >= questions.length) {
                document.getElementById('quiz-question').innerText = `🏆 Selesai! Skor Level ${currentLevel} kamu: ${quizScore} / ${questions.length * 50}`;
                document.getElementById('quiz-options').innerHTML = `<button class="option-btn" onclick="changeQuizLevel(${currentLevel})" style="grid-column: span 2; background:var(--primary); color:white;">Ulangi Level Ini 🔄</button>`;
                return;
            }
            let qData = questions[currentQuizIdx];
            document.getElementById('quiz-question').innerText = `Soal ${currentQuizIdx + 1}: ${qData.q}`;
            let optHTML = "";
            qData.options.forEach(opt => {
                optHTML += `<button class="option-btn" onclick="checkQuizAnswer('${opt}', '${qData.answer}')">${opt}</button>`;
            });
            document.getElementById('quiz-options').innerHTML = optHTML;
            document.getElementById('quiz-score').innerText = `Skor: ${quizScore}`;
        }

        function checkQuizAnswer(selected, correct) {
            if(selected === correct) {
                quizScore += 50;
                alert("Benar sekali! 🌟");
            } else {
                alert("Kurang tepat. Jawaban yang benar adalah: " + correct);
            }
            currentQuizIdx++;
            loadQuizQuestion();
        }

        window.onload = function() {
            initGame();
            changeQuizLevel(1);
        };
    </script>
</body>
</html>
