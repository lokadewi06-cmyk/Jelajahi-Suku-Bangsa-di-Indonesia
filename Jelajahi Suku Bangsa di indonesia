    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #FF6B6B;
            --secondary: #4ECDC4;
            --accent: #FFE66D;
            --dark: #2C3E50;
            --light: #F7F9FA;
            --card-bg: #FFFFFF;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Quicksand', sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background: linear-gradient(135deg, #FF6B6B, #FF8E53);
            color: white;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        header h1 {
            font-family: 'Fredoka', cursive;
            font-size: 2.2rem;
            margin-bottom: 0.3rem;
        }

        header p {
            font-size: 1.1rem;
            font-weight: 700;
        }

        nav {
            background-color: white;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            padding: 1rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav button {
            background-color: var(--light);
            border: 2px solid #E2E8F0;
            border-radius: 20px;
            padding: 8px 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--dark);
        }

        nav button:hover, nav button.active {
            background-color: var(--secondary);
            color: white;
            border-color: var(--secondary);
            transform: translateY(-2px);
        }

        main {
            flex: 1;
            max-width: 1000px;
            width: 100%;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .section {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 1.5rem;
        }

        .item-card {
            background: var(--card-bg);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border-top: 5px solid var(--primary);
            transition: transform 0.3s;
            display: flex;
            flex-direction: column;
        }

        .item-card:hover {
            transform: translateY(-5px);
        }

        .card-img-container {
            width: 100%;
            height: 140px;
            background: linear-gradient(135deg, #fbc531, #e84118);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Fredoka', cursive;
            font-size: 1.3rem;
            text-align: center;
            padding: 10px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        }

        .card-content {
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .item-card h3 {
            font-family: 'Fredoka', cursive;
            color: var(--primary);
            margin-bottom: 8px;
            font-size: 1.2rem;
        }

        .item-card p {
            font-size: 0.9rem;
            color: #555;
            line-height: 1.5;
            margin-bottom: 12px;
            flex: 1;
        }

        .yt-btn {
            display: inline-block;
            background-color: #FF0000;
            color: white;
            padding: 8px 12px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            text-align: center;
            transition: opacity 0.2s;
        }

        .yt-btn:hover {
            opacity: 0.85;
        }

        .game-container, .quiz-container {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            text-align: center;
        }

        .level-selector {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .level-btn {
            background-color: var(--accent);
            border: none;
            padding: 10px 20px;
            border-radius: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .level-btn.active-level {
            background-color: var(--primary);
            color: white;
        }

        .question-box {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--dark);
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            max-width: 600px;
            margin: 0 auto;
        }

        .option-btn {
            background-color: var(--light);
            border: 2px solid #CBD5E1;
            padding: 15px;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .option-btn:hover {
            background-color: var(--secondary);
            color: white;
            border-color: var(--secondary);
        }

        .intro-box {
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
